{
  "name": "blitzecdn-web",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next",
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind && node scripts/copy-search-index.mjs",
    "preview": "node scripts/serve-static.mjs out 4173",
    "build:book": "node scripts/build-book.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:links": "node scripts/check-links.mjs out",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run check:docs && npm run check:surface && npm run build && npm run check:links",
    "check:surface": "node scripts/check-api-surface.mjs"
  },
  "dependencies": {
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@vivliostyle/cli": "^11.4.0",
    "eslint": "10.14.0",
    "eslint-config-next": "^16.4.5",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "prismjs": "1.30.0",
    "trim": "1.0.1",
    "uuid": "14.0.2",
    "valibot": "1.4.2",
    "zod": "4.3.6"
  }
}
