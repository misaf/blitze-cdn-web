{
  "name": "blitzecdn-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next",
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "generate": ".venv/bin/python scripts/generate_reference.py",
    "generate:check": ".venv/bin/python scripts/generate_reference.py --check",
    "sources": ".venv/bin/pip install -q -r requirements.txt && .venv/bin/ansible-galaxy collection install -r requirements.yml -p .state/collections"
  },
  "dependencies": {
    "next": "^16.0.7",
    "nextra": "4.5.1",
    "nextra-theme-docs": "4.5.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  }
}
